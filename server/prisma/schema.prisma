generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User roles
enum UserRole {
  ADMIN
  USER
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  CONTACTED
  COMPLETED
  REJECTED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

// User account
model User {
  id       String @id @default(uuid()) @db.Uuid
  fullName String @db.VarChar(100)
  email    String @unique @db.VarChar(255)
  password String @db.VarChar(255)

  role     UserRole @default(USER)
  isActive Boolean  @default(true)

  refreshTokens     RefreshToken[]
  passwordResetOtps PasswordResetOtp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blogs     Blog[]

  @@map("users")
}

// Refresh token sessions
model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @db.VarChar(255)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetOtp {
  id      String @id @default(uuid()) @db.Uuid
  otpHash String @db.VarChar(255)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_otps")
}

model ContactInquiry {
  id String @id @default(uuid()) @db.Uuid

  fullName String  @db.VarChar(100)
  email    String  @db.VarChar(255)
  phone    String? @db.VarChar(20)

  serviceRequired String @db.VarChar(100)
  projectType     String @db.VarChar(100)
  projectDetails  String @db.Text

  privacyAccepted Boolean @default(false)

  status InquiryStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contact_inquiries")
}

model Blog {
  id String @id @default(uuid()) @db.Uuid

  // Basic information
  title         String  @db.VarChar(255)
  slug          String  @unique @db.VarChar(255)
  excerpt       String? @db.Text
  featuredImage String? @db.VarChar(500)
  imageAlt      String? @db.VarChar(255)

  // Rich text editor content
  content Json?

  // SEO information
  metaTitle       String? @db.VarChar(255)
  metaDescription String? @db.VarChar(500)
  focusKeyword    String? @db.VarChar(255)
  canonicalUrl    String? @db.VarChar(500)

  // Publishing information
  status      BlogStatus @default(DRAFT)
  isFeatured  Boolean    @default(false)
  readingTime Int        @default(1)
  publishedAt DateTime?

  // Author information
  authorId   String? @db.Uuid
  authorName String? @db.VarChar(100)

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  // Category relationship
  categoryId String?       @db.Uuid
  category   BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Tags relationship
  tags BlogTagRelation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([isFeatured])
  @@index([createdAt])
  @@map("blogs")
}

// Blog categories
model BlogCategory {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(100)
  slug        String  @unique @db.VarChar(150)
  description String? @db.Text

  blogs Blog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blog_categories")
}

// Blog tags
model BlogTag {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(100)
  slug String @unique @db.VarChar(150)

  blogs BlogTagRelation[]

  createdAt DateTime @default(now())

  @@map("blog_tags")
}

// Blog and tag relationship
model BlogTagRelation {
  blogId String @db.Uuid
  tagId  String @db.Uuid

  blog Blog    @relation(fields: [blogId], references: [id], onDelete: Cascade)
  tag  BlogTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogId, tagId])
  @@index([tagId])
  @@map("blog_tag_relations")
}

// Project categories
model ProjectCategory {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(100)
  slug        String  @unique @db.VarChar(150)
  description String? @db.Text

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("project_categories")
}

// Projects
model Project {
  id String @id @default(uuid()) @db.Uuid

  // Basic project information
  title       String @db.VarChar(255)
  slug        String @unique @db.VarChar(255)
  description String @db.Text

  // Project image
  imageUrl String  @db.VarChar(500)
  imageAlt String? @db.VarChar(255)

  // Project completion date
  completionDate DateTime @db.Date

  // Project category
  categoryId String          @db.Uuid
  category   ProjectCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Display management
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([sortOrder])
  @@index([isPublished])
  @@index([completionDate])
  @@map("projects")
}

model GalleryCategory {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(100)
  slug        String  @unique @db.VarChar(150)
  description String? @db.Text

  galleryItems Gallery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gallery_categories")
}

model Gallery {
  id String @id @default(uuid()) @db.Uuid

  title       String  @db.VarChar(255)
  description String? @db.Text

  imageUrl String  @db.VarChar(500)
  imageAlt String? @db.VarChar(255)

  categoryId String          @db.Uuid
  category   GalleryCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  sortOrder   Int     @default(0)
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([sortOrder])
  @@index([isPublished])
  @@map("gallery")
}

model MediaCoverage {
  id String @id @default(uuid()) @db.Uuid

  name     String @db.VarChar(150)
  headline String @db.VarChar(500)
  excerpt  String @db.Text

  url String @db.VarChar(1000)

  imageUrl String  @db.VarChar(500)
  imageAlt String? @db.VarChar(255)

  sortOrder   Int     @default(0)
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([isPublished])
  @@index([createdAt])
  @@map("media_coverage")
}

model TeamMember {
  id String @id @default(uuid()) @db.Uuid

  name      String   @db.VarChar(150)
  position  String   @db.VarChar(150)
  bio       String   @db.Text
  skills    String[] @default([])
  education String?  @db.Text

  imageUrl String  @db.VarChar(500)
  imageAlt String? @db.VarChar(255)

  socialLinks Json?

  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([isPublished])
  @@map("team_members")
}

model Testimonial {
  id String @id @default(uuid()) @db.Uuid

  name String @db.VarChar(150)
  role String @db.VarChar(150)

  imageUrl String  @db.VarChar(500)
  imageAlt String? @db.VarChar(255)

  logoImageUrl String  @db.VarChar(500)
  logoImageAlt String? @db.VarChar(255)

  content String @db.Text

  rating Int

  sortOrder   Int     @default(0)
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([isPublished])
  @@index([rating])
  @@map("testimonials")
}

model Service {
  id               String   @id @default(uuid()) @db.Uuid
  title            String   @db.VarChar(200)
  slug             String   @unique @db.VarChar(220)
  shortDescription String   @db.VarChar(500)
  description      String   @db.Text
  category         String   @db.VarChar(100)
  benefits         String[] @default([])
  imageUrl         String   @db.VarChar(500)
  imageAlt         String?  @db.VarChar(255)
  sortOrder        Int      @default(0)
  isPublished      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sortOrder])
  @@index([isPublished])
  @@index([category])
  @@map("services")
}

model WhyChooseUs {
  id          String   @id @default(uuid()) @db.Uuid
  icon        String   @db.VarChar(100)
  title       String   @db.VarChar(200)
  description String   @db.Text
  features    String[] @default([])
  color       String   @db.VarChar(50)
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@index([isPublished])
  @@map("why_choose_us")
}



model Statistic {
  id          String   @id @default(uuid()) @db.Uuid
  value       String   @db.VarChar(50)
  label       String   @db.VarChar(150)
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@index([isPublished])
  @@map("statistics")
}


model ProcessStep {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(200)
  description String   @db.Text
  position    Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([position])
  @@index([isPublished])
  @@map("process_steps")
}